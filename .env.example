# Which LLM to call: openai (any OpenAI-compatible endpoint), bri (internal BRI service), or fake (offline demo)
LLM_PROVIDER=fake

# For LLM_PROVIDER=openai. Works with OpenAI, Groq, a local Ollama (http://localhost:11434/v1), vLLM ...
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=replace-me
LLM_MODEL=replace-with-a-model-id-your-endpoint-serves
LLM_MAX_TOKENS=4096

# For LLM_PROVIDER=bri (only reachable inside the BRI network; kept for reference)
LLAMA_ENDPOINT=
LLAMA_KEY=
